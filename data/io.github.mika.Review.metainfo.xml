<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.mika.Review</id>
  <name>Review</name>
  <summary>View, organize, and annotate PDFs and images</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.mika"><name>Review contributors</name></developer>
  <url type="homepage">https://github.com/mika/review</url>
  <description>
    <p>Review is a focused GNOME viewer for PDFs and images. It supports annotations,
    reusable visual signatures, page organization, secure cropping, and conversion
    of PDF pages to 300 DPI color images.</p>
  </description>
  <launchable type="desktop-id">io.github.mika.Review.desktop</launchable>
  <provides>
    <binary>review</binary>
    <mediatype>application/pdf</mediatype>
    <mediatype>image/png</mediatype>
    <mediatype>image/jpeg</mediatype>
  </provides>
  <releases>
    <release version="0.1.0" date="2026-07-18"/>
  </releases>
  <content_rating type="oars-1.1"/>
</component>
